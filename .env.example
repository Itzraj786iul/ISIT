# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT secret key — use a strong random string in production (min 32 chars)
JWT_SECRET=change-me-to-a-strong-random-secret

# OpenAI API key for AI tutor and quiz generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: call FastAPI for session player (sessions, events, ask, end) instead of Next /api/*
# When true, the browser sends Bearer tokens from localStorage (`auth_token`) — login/signup sync the JWT there.
NEXT_PUBLIC_USE_EXTERNAL_API=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Production checklist ---
# - Set JWT_SECRET (32+ random chars), MONGO_URI, OPENAI_API_KEY on the host.
# - NEXT_PUBLIC_* vars are exposed to the browser; never put secrets in NEXT_PUBLIC_.
# - Enable HTTPS; cookies use Secure in production.
# - Point NEXT_PUBLIC_API_BASE_URL at your FastAPI origin when using external API mode; configure CORS there.
