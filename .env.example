# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT secret key — use a strong random string in production (min 32 chars)
JWT_SECRET=change-me-to-a-strong-random-secret

# OpenAI API key for AI tutor and quiz generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: call FastAPI for session player (sessions, events, ask, end) instead of Next /api/*
# When true, the browser sends Bearer tokens from localStorage (`auth_token`) — login/signup sync the JWT there.
NEXT_PUBLIC_USE_EXTERNAL_API=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public site URL — must include protocol (http:// or https://). Used for metadataBase, emails, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support / legal contact (shown in Terms, Footer)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@isic.in

# Transactional email (optional — without this, emails are logged server-side only)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=ISIC <onboarding@resend.dev>

# AI rate limits (per authenticated user, in-memory; use Redis/Upstash in multi-instance prod)
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX_PER_WINDOW=40

# Resend email verification throttling
# RATE_LIMIT_RESEND_VERIFY_WINDOW_MS=3600000
# RATE_LIMIT_RESEND_VERIFY_MAX=5

# Razorpay (optional — if unset, checkout uses mock payment)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Production checklist ---
# - Set JWT_SECRET (32+ random chars), MONGO_URI, OPENAI_API_KEY on the host.
# - NEXT_PUBLIC_* vars are exposed to the browser; never put secrets in NEXT_PUBLIC_.
# - Enable HTTPS; cookies use Secure in production.
# - Point NEXT_PUBLIC_API_BASE_URL at your FastAPI origin when using external API mode; configure CORS there.
# - For real email, set RESEND_API_KEY; for live payments, set all Razorpay keys.
